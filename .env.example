# =============================================================================
# Abeta SDUI Domain BFF — Environment Configuration Example
# Copy to `.env` for local overrides (`.env` is gitignored).
# =============================================================================

# --- HTTP Server ---
PORT=8085
GIN_MODE=release
LOG_LEVEL=info

# --- Optional Abeta Dynamic Layout Engine Integration ---
# Leave empty to run completely standalone with zero external dependencies.
# Set to your running Abeta-dev/layout-engine URL (e.g. http://localhost:8090)
# to enable dynamic CMS-managed layout hydration with automatic standalone fallback.
LAYOUT_ENGINE_URL=
# LAYOUT_ENGINE_URL=http://localhost:8090

# --- Security & Rate Limiting (Optional) ---
# Leave JWT_SECRET empty for unauthenticated local/demo access.
JWT_SECRET=
# Set RATE_LIMIT_RPS > 0 (e.g. 100) to enable global per-second request throttling; 0 disables it.
RATE_LIMIT_RPS=0
